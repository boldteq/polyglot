node_modules/
data/
*.db
*.db-wal
*.db-shm
*.migrated
.env
.env.local

# Secrets — config.json holds the encrypted backup PAT (C1 audit). Never commit.
config.json
.~lock.*#

# Build artifacts — regenerated by `pnpm build`, must not be tracked (C20 audit)
public-dist/

# Runtime Claude session logs — generated, never read by Polyglot code (C20 audit)
projects/

# Orphan stale copies of ~/.claude/* — NOT the backup (backup.js writes to ~/.claude/.backups/repo
# + a private GitHub repo). Runtime always reads ~/.claude; these repo-root copies are unreferenced.
# (agent-versions/ is KEPT — routes/agents.js:26 reads it.) Anchored to root so nested .claude/<dir>
# and src/lib/<dir> are never matched.
/agents/
/memory/
/commands/
/rules/
/templates/
/conversations/

# Standardize on pnpm (C tech-debt audit)
package-lock.json

# OS + runtime junk
.DS_Store
.claude/scheduled_tasks.lock

# Research scratch (theme clones for KB teardowns)
.research/

# theme-toolkit gate run artifacts (per-client-repo evidence; never vendored)
gate-reports/
**/gate-reports/
