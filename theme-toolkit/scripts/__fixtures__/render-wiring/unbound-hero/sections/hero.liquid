<div class="hero">
  {%- if section.settings.image -%}
    {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager' }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder-svg' }}
  {%- endif -%}
  <h1 class="hero__title">{{ section.settings.heading }}</h1>
</div>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Move with intent" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
