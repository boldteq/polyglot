{% comment %}
  Pairs with faq-accordion.liquid: both ship heading_size default "large" (every section does — it is
  a STYLE default, not heading copy) and a placeholder phone number that belongs to nobody.
{% endcomment %}

<div class="contact-strip color-{{ section.settings.color_scheme }}">
  <h2 class="h-{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subheading }}</p>
  <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
</div>

{% schema %}
{
  "name": "t:sections.contact-strip.name",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.contact-strip.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "t:sections.contact-strip.settings.heading.label" },
    { "type": "text", "id": "subheading", "label": "t:sections.contact-strip.settings.subheading.label" },
    { "type": "text", "id": "phone", "label": "t:sections.contact-strip.settings.phone.label", "default": "+91 0000000000" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.contact-strip.settings.heading_size.label",
      "options": [
        { "value": "medium", "label": "t:sections.contact-strip.settings.heading_size.options__1" },
        { "value": "large", "label": "t:sections.contact-strip.settings.heading_size.options__2" }
      ],
      "default": "large"
    }
  ],
  "presets": [{ "name": "t:sections.contact-strip.presets.name" }]
}
{% endschema %}
