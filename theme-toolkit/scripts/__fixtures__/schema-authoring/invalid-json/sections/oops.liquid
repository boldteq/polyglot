<div class="oops color-{{ section.settings.color_scheme }}">{{ section.settings.heading }}</div>

{%- schema -%}
{
  "name": "t:sections.oops.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.oops.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "t:sections.oops.settings.heading.label" },
  ]
}
{%- endschema -%}
