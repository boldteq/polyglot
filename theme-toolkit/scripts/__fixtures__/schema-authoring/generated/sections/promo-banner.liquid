<div class="promo-banner color-{{ section.settings.color_scheme }}">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subheading }}</p>
</div>

{% schema %}
{
  "name": "t:sections.promo-banner.name",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.promo-banner.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "t:sections.promo-banner.settings.heading.label" },
    { "type": "text", "id": "subheading", "label": "t:sections.promo-banner.settings.subheading.label" }
  ]
}
{% endschema %}
