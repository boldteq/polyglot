{{ 'section-promo-strip.css' | asset_url | stylesheet_tag }}

{%- comment -%} CLEAN: a presets entry → preset-missing silent. {%- endcomment -%}
<div class="promo-strip color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="promo-strip__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="promo-strip__sub">{{ section.settings.subheading }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.promo-strip.name",
  "tag": "section",
  "class": "section-promo-strip",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.promo-strip.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "t:sections.promo-strip.settings.heading.label" },
    { "type": "text", "id": "subheading", "label": "t:sections.promo-strip.settings.subheading.label" }
  ],
  "presets": [{ "name": "t:sections.promo-strip.presets.name" }]
}
{% endschema %}
