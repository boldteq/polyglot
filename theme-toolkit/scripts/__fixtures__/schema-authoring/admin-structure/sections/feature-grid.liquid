{{ 'section-feature-grid.css' | asset_url | stylesheet_tag }}

{%- comment -%} FIRES schema.blocks-no-limit: typed "feature" block, no max_blocks, no per-type limit. {%- endcomment -%}
<div class="feature-grid color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="feature-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="feature-grid__sub">{{ section.settings.subheading }}</p>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <ul class="feature-grid__list" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.feature-grid.name",
  "tag": "section",
  "class": "section-feature-grid",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.feature-grid.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "t:sections.feature-grid.settings.heading.label" },
    { "type": "text", "id": "subheading", "label": "t:sections.feature-grid.settings.subheading.label" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.feature-grid.blocks.feature.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.feature-grid.blocks.feature.settings.heading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.feature-grid.blocks.feature.settings.text.label" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.feature-grid.presets.name", "blocks": [ { "type": "feature" }, { "type": "feature" }, { "type": "feature" } ] }]
}
{% endschema %}
