<div class="hero">
  {%- if section.settings.image -%}
    {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager' }}
  {%- else -%}
    {%- render 'premium-placeholder', type: 'hero' -%}
  {%- endif -%}
  <h1 class="hero__title" style="font-family: var(--font-heading-family)">{{ section.settings.heading }}</h1>
</div>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quiet luxury skincare" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
