{
  "name": "@boldteq/theme-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gates": "node scripts/theme-gates.mjs",
    "gates:static": "node scripts/theme-gates.mjs --static-only",
    "gates:verify": "node scripts/theme-gates.mjs --verify",
