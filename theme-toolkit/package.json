{
  "name": "@boldteq/theme-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gates": "node scripts/theme-gates.mjs",
    "gates:static": "node scripts/theme-gates.mjs --static-only",
    "gates:verify": "node scripts/theme-gates.mjs --verify",
    "changes:check": "node scripts/check-changes-list.mjs",
    "check:briefs": "node scripts/check-briefs.mjs",
    "check:reuse-map": "node scripts/check-reuse-map.mjs",
    "check:schema": "node scripts/check-metafield-schema.mjs",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "store:preflight": "node scripts/porter-preflight.mjs",
    "store:apply": "node scripts/porter-apply.mjs",
    "store:verify": "node scripts/porter-verify.mjs",
    "keystone:provision": "node scripts/keystone-provision.mjs",
    "keystone:register": "node scripts/keystone-register.mjs",
    "keystone:link": "node scripts/keystone-link.mjs",
    "keystone:token": "node scripts/keystone-token.mjs",
    "keystone:status": "node scripts/keystone-status.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "lighthouse": "13.4.0",
    "playwright": "1.60.0"
  }
}
