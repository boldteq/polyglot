{
  "name": "@boldteq/theme-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gates": "node scripts/theme-gates.mjs",
    "gates:static": "node scripts/theme-gates.mjs --static-only",
    "gates:verify": "node scripts/theme-gates.mjs --verify",
    "gates:verify:full": "node scripts/theme-gates.mjs --verify --require-full",
    "test": "node scripts/run-all-tests.mjs",
    "lens": "node scripts/lens-capture.mjs && node scripts/lens-judge.mjs && node scripts/check-visual-truth.mjs",
    "lens:capture": "node scripts/lens-capture.mjs",
    "lens:judge": "node scripts/lens-judge.mjs",
    "lens:enforce": "node scripts/check-visual-truth.mjs",
    "lens:surface": "node scripts/lens-surface.mjs",
    "gates:list": "node scripts/theme-gates.mjs --list",
    "theme:audit": "node scripts/theme-gates.mjs --static-only",
    "theme:audit:full": "node scripts/theme-gates.mjs",
    "theme:link": "node scripts/shopify-theme-link.mjs",
    "theme:dev": "node scripts/shopify-theme-dev.mjs",
    "theme:push": "node scripts/shopify-theme-push.mjs",
    "theme:guard": "node scripts/shopify-theme-guard.mjs",
    "theme:relink": "node scripts/shopify-theme-relink.mjs",
    "check:discovery": "node scripts/check-discovery.mjs",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "changes:check": "node scripts/check-changes-list.mjs",
    "check:briefs": "node scripts/check-briefs.mjs",
    "check:reuse-map": "node scripts/check-reuse-map.mjs",
    "check:inbuilt-css": "node scripts/check-inbuilt-css-first.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:consistency": "node scripts/check-consistency.mjs",
    "check:antipatterns": "node scripts/check-antipatterns.mjs",
    "check:schema": "node scripts/check-metafield-schema.mjs",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "store:preflight": "node scripts/porter-preflight.mjs",
    "store:apply": "node scripts/porter-apply.mjs",
    "store:verify": "node scripts/porter-verify.mjs",
    "keystone:clone": "node scripts/keystone-clone.mjs",
    "keystone:token": "node scripts/keystone-token.mjs",
    "lens:autofix": "node scripts/lens-autofix.mjs",
    "ds:css": "node scripts/generate-design-system-css.mjs",
    "overrides:check": "node scripts/check-client-overrides.mjs",
    "build-state": "node scripts/build-state.mjs",
    "maestro:dryrun": "node scripts/maestro-dryrun.mjs",
    "maestro:preflight": "node scripts/maestro-preflight.mjs",
    "maestro:run": "node scripts/maestro-run.mjs",
    "maestro:build": "node scripts/maestro-build.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "lighthouse": "13.4.0",
    "playwright": "1.60.0"
  }
}
