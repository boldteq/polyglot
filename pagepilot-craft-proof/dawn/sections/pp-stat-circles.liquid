{%- comment -%}
  PagePilot quantified-social-proof — CRAFTED for Dawn (BUILD-CUSTOM: no native stat-ring section).
  Source card: design/ecom/pagepilot-library/components/social-proof/quantified-social-proof.md
  CRAFTED, NOT PASTED — built entirely on Dawn's built-in CSS vars + color schemes:
    color  → rgb(var(--color-foreground)) / rgb(var(--color-button)) (the active scheme; never a hex)
    radius → var(--media-radius)
    width  → var(--page-width)
    spacing→ section padding settings (Dawn 0–100 step 4) + var(--spacing-sections-desktop)
  HONESTY: every percentage is a placeholder self-reported stat → bind real data; keep the disclaimer.
{%- endcomment -%}

{%- style -%}
  .pp-stat-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .pp-stat__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: var(--grid-mobile-horizontal-spacing, 1rem);
    max-width: var(--page-width);
    margin: 0 auto;
    padding-inline: 1.5rem;
  }
  @media screen and (min-width: 750px) {
    .pp-stat__grid { grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: var(--grid-desktop-horizontal-spacing, 1.5rem); }
  }
  .pp-stat__card {
    /* gradient FILL from the active scheme accent — no hardcoded color */
    background: linear-gradient(135deg, rgba(var(--color-button), 0.78), rgb(var(--color-button)));
    color: rgb(var(--color-button-text));
    border-radius: var(--media-radius);
    padding: 1.5rem 1rem;
    text-align: center;
  }
  .pp-stat__ring { width: 80px; height: 80px; margin: 0 auto 0.75rem; display: block; transform: rotate(-90deg); }
  .pp-stat__track { stroke: rgb(var(--color-button-text)); opacity: 0.25; }
  .pp-stat__value-ring { stroke: rgb(var(--color-button-text)); stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 1.1s ease; }
  .pp-stat__card.is-in .pp-stat__value-ring { stroke-dashoffset: calc(100 - var(--pp-val)); }
  .pp-stat__num { font-size: 1.75rem; font-weight: bold; line-height: 1; }
  .pp-stat__label { display: block; margin-top: 0.5rem; font-size: 0.95rem; }
  .pp-stat__disclaimer { max-width: var(--page-width); margin: 1rem auto 0; padding-inline: 1.5rem; text-align: center; font-size: 0.8rem; opacity: 0.7; }
  @media (prefers-reduced-motion: reduce) {
    .pp-stat__value-ring { transition: none; stroke-dashoffset: calc(100 - var(--pp-val)); }
  }
{%- endstyle -%}

<div class="pp-stat-{{ section.id }} color-{{ section.settings.color_scheme }} isolate">
  {%- if section.settings.heading != blank -%}
    <h2 class="pp-stat__heading" style="text-align:center;max-width:var(--page-width);margin:0 auto 1.5rem;">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="pp-stat__grid" role="list">
    {%- for block in section.blocks -%}
      <div class="pp-stat__card" role="listitem" style="--pp-val: {{ block.settings.value | default: 0 }};" {{ block.shopify_attributes }}>
        <svg class="pp-stat__ring" viewBox="0 0 36 36" aria-hidden="true">
          <circle class="pp-stat__track" cx="18" cy="18" r="15.915" fill="none" stroke-width="3" pathLength="100"></circle>
          <circle class="pp-stat__value-ring" cx="18" cy="18" r="15.915" fill="none" stroke-width="3" pathLength="100"></circle>
        </svg>
        <span class="pp-stat__num">{{ block.settings.value | default: 0 }}{{ block.settings.suffix }}</span>
        <span class="pp-stat__label">{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.settings.disclaimer != blank -%}
    <p class="pp-stat__disclaimer color-{{ section.settings.color_scheme }}">{{ section.settings.disclaimer }}</p>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !('IntersectionObserver' in window)) {
      if (root) root.querySelectorAll('.pp-stat__card').forEach(function (c) { c.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.4 });
    root.querySelectorAll('.pp-stat__card').forEach(function (c) { io.observe(c); });
  })();
</script>

{% schema %}
{
  "name": "PP Stat Circles",
  "tag": "section",
  "class": "pp-stat-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real customers reported" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 2, "step": 1, "label": "Columns (mobile)", "default": 2 },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer (bind to real methodology — never invent)", "default": "Based on self-reported results from customers who used the product consistently. Individual results vary." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "range", "id": "value", "min": 0, "max": 100, "step": 1, "label": "Value (bind real data)", "default": 90 },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
        { "type": "text", "id": "label", "label": "Label", "default": "felt a difference" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "PP Stat Circles", "blocks": [ { "type": "stat" }, { "type": "stat" }, { "type": "stat" }, { "type": "stat" } ] } ]
}
{% endschema %}
