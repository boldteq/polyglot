# Keystone provisioning service — Railway env vars (set in Railway dashboard, NEVER commit real values)
PORT=8080
# Railway Postgres plugin provides this:
DATABASE_URL=postgresql://user:pass@host:5432/railway
# 64 hex chars (32 bytes) for AES-256-GCM field encryption — generate: openssl rand -hex 32
KEYSTONE_ENC_KEY=
# Bearer key for the authed endpoints (/register /token /status /revoke) — generate: openssl rand -hex 32
KEYSTONE_API_KEY=
# Public base URL of THIS deployed service (the OAuth redirect_uri = <base>/auth/callback).
# Set each client app's "Allowed redirection URL" in the Partner Dashboard to <base>/auth/callback.
KEYSTONE_BASE_URL=https://keystone-production.up.railway.app
